# Sao chép thành .env (không commit .env).

# Vector store Day 6: PostgreSQL + pgvector chạy bằng docker compose trong repo Day 6 (starter/).
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
DAY6_STRATEGY=A

# Embedding model phải trùng với lúc ingest Day 6.
EMBEDDING_MODEL=BAAI/bge-m3

# Reranker (cross-encoder, chạy local CPU). Cache đặt ngoài ổ C nếu ổ C ít chỗ (~2.3 GB).
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CACHE_DIR=E:\ai20k_lab\.hf_cache

# Model agent (hỗ trợ tool calling) — điền ở checkpoint 2, chọn MỘT provider.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-nano
# Để trống với OpenAI; đặt khi dùng endpoint tương thích OpenAI khác (Gemini, OpenRouter, Ollama).
LLM_BASE_URL=
# Model GPT-5: minimal | low | medium | high. Thấp hơn = ít token reasoning (output) hơn, nhanh và rẻ hơn.
LLM_REASONING_EFFORT=low
# Đơn giá USD / 1M token để tính chi phí (theo developers.openai.com/api/docs/pricing, tra ngày 2026-11-16).
LLM_PRICE_INPUT_PER_M=0.05
LLM_PRICE_CACHED_INPUT_PER_M=0.005
LLM_PRICE_OUTPUT_PER_M=0.40
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
